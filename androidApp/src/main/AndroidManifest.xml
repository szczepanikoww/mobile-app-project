<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Rest-timer notification (D7): asked for the first time a rest starts, after a one-line explanation. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact rest-end alarm; without it the app falls back to an inexact alarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <application android:name="com.trainingapp.android.TrainingApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Posts "Koniec przerwy" when the rest alarm fires, also after the process was killed. -->
        <receiver
            android:name="com.trainingapp.feature.workoutlogging.rest.RestTimerReceiver"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
