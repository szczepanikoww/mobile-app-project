-- The trainer's own exercises. Global exercises come from the bundled seed (later: synced from the server).
CREATE TABLE custom_exercise (
    id TEXT NOT NULL PRIMARY KEY,
    owner_trainer_id TEXT NOT NULL,
    json TEXT NOT NULL,
    sync_state TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Status overrides for global exercises are not needed: only own exercises can be hidden.

-- REPLACE gives the row a new rowid, which orders uses made in the same millisecond.
CREATE TABLE exercise_usage (
    exercise_id TEXT NOT NULL PRIMARY KEY,
    last_used_at INTEGER NOT NULL
);

selectAllCustom:
SELECT * FROM custom_exercise;

selectCustomById:
SELECT * FROM custom_exercise WHERE id = ?;

selectPendingCustom:
SELECT * FROM custom_exercise WHERE sync_state != 'SYNCED';

upsertCustom:
INSERT OR REPLACE INTO custom_exercise(id, owner_trainer_id, json, sync_state, updated_at) VALUES (?, ?, ?, ?, ?);

updateSyncState:
UPDATE custom_exercise SET sync_state = ? WHERE id = ? AND updated_at = ?;

selectRecentlyUsed:
SELECT exercise_id FROM exercise_usage ORDER BY last_used_at DESC, rowid DESC LIMIT :limit;

markUsed:
INSERT OR REPLACE INTO exercise_usage(exercise_id, last_used_at) VALUES (?, ?);
